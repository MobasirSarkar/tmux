{
  "find-it-faster.general.useTerminalInEditor": true,
  "files.autoSave": "afterDelay",
  "terminal.integrated.inheritEnv": false,
  "editor.fontSize": 15,
  "editor.fontFamily": "'Fira Code', 'Lilex Nerd Font', monospace",
  "editor.fontLigatures": true,
  "workbench.productIconTheme": "material-product-icons",
  "workbench.colorTheme": "Bluloco Dark",
  "explorer.confirmDelete": false,
  "editor.minimap.enabled": false,
  "workbench.preferredHighContrastColorTheme": "Moonlight II Italic",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.smoothScrolling": true,
  "editor.cursorStyle": "line-thin",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": false
  },
  "remote.SSH.remotePlatform": {
    "103.119.170.139": "linux",
    "10.159.234.59": "linux"
  },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
  },
  "github.copilot.enable": {
    "*": false
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "git.confirmSync": false,
  "editor.formatOnPaste": true,
  "editor.experimental.preferTreeSitter.typescript": true,
  "workbench.iconTheme": "file-icons",
  "github.copilot.chat.codesearch.enabled": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "comment.block.documentation"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "keyword.other.function"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable.other.object",
          "meta.object-literal.key",
          "support.type.object"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable.language",
          "variable.parameter",
          "variable.other.readwrite"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "workbench.startupEditor": "none"
}
